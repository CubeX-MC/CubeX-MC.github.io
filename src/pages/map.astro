---
import InstituteLayout from '../layouts/InstituteLayout.astro';
import Guestbook from '../components/Guestbook.astro';

const numberFormatter = new Intl.NumberFormat('zh-CN');

const specimen = [
  { key: '一周目区域', value: numberFormatter.format(1366) },
  { key: '二周目区域', value: numberFormatter.format(375) },
  { key: '地图瓦片', value: numberFormatter.format(6271) },
  { key: '坐标跨度', value: '160,000 × 160,000' },
  { key: '渲染区块', value: numberFormatter.format(1562016) },
  { key: '生成时间', value: '2026-05-23 17:05' },
];
---

<InstituteLayout
  title="存档合并 · CubeX 研究院"
  description="CubeX Lite 一二周目合并后的主世界领地可视化，二周目坐标保持不变，一周目领地平移并添加 zm1 前缀。"
  section="MAP"
>
  <article>
    <header class="shell plate">
      <div class="plate-head">
        <p class="label">Instrument · M</p>
        <p class="label-cn">CubeX Lite · 主世界</p>
      </div>

      <h1 class="display-sm">一二周目存档合并</h1>

      <p class="lede">
        二周目主世界 4w × 4w 区域保留原坐标嵌入一周目空区；一周目 16w × 16w 存档整体平移后合并，
        所有一周目领地已加上 zm1 前缀。
      </p>
    </header>

    <section class="shell block">
      <div class="tick-rule" aria-hidden="true"></div>
      <div class="index-head">
        <p class="label">Specimen</p>
        <p class="label-cn">
          <a href="/merge_residence_map/index.html" target="_blank" rel="noopener" class="row-action">打开全屏 ↗</a>
        </p>
      </div>

      <dl class="measure">
        {specimen.map((item) => (
          <div>
            <dt>{item.key}</dt>
            <dd class="data">{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="shell block">
      <div class="tick-rule" aria-hidden="true"></div>
      <div class="index-head"><p class="label">Figure · Merged World</p></div>

      <div class="map-frame">
        <iframe src="/merge_residence_map/index.html" title="CubeX Lite 一二周目存档合并领地地图" loading="lazy"></iframe>
      </div>

      <p class="map-key">
        <span class="key key-1">zm1 · 一周目平移领地</span>
        <span class="key key-2">zm2 · 二周目原坐标领地</span>
      </p>
    </section>

    <Guestbook />
  </article>

  <style>
    .measure {
      display: grid;
      margin: 0;
      border-top: 1px solid var(--rule-soft);
    }

    @media (min-width: 720px) {
      .measure {
        grid-template-columns: 1fr 1fr;
        column-gap: 48px;
      }
    }

    .measure div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding-block: 11px;
      border-bottom: 1px solid var(--rule-soft);
    }

    .measure dt {
      font-size: 0.8125rem;
      color: var(--fg-3);
    }

    .measure dd {
      margin: 0;
      color: var(--fg);
    }

    .map-frame {
      margin-top: 6px;
      border: 1px solid var(--rule);
      background: rgba(0, 0, 0, 0.25);
    }

    .map-frame iframe {
      display: block;
      width: 100%;
      height: 72vh;
      min-height: 480px;
      border: 0;
    }

    .map-key {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin: 12px 0 0;
      font-size: 0.75rem;
    }

    .key {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--fg-3);
    }

    .key::before {
      content: '';
      width: 8px;
      height: 8px;
    }

    .key-1::before { background: var(--gold); }
    .key-2::before { background: var(--dev); }
  </style>
</InstituteLayout>
